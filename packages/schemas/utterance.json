{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayusetu.in/schemas/utterance.json",
  "title": "Utterance",
  "type": "object",
  "required": ["id", "encounter_id", "seq", "speaker", "text", "lang", "asr_confidence", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "encounter_id": { "type": "string", "format": "uuid" },
    "seq": { "type": "integer" },
    "speaker": { "type": "string" },
    "text": { "type": "string" },
    "lang": { "type": "string" },
    "asr_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "audio_uri": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
