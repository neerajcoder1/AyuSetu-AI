{
  "id": "RF-OB-001",
  "tier": 1,
  "version": 2,
  "title": "High-Risk Obstetric Emergency",
  "description": "Active pregnancy with acute vaginal bleeding, severe headache, reduced fetal movement, or convulsions",
  "when": {
    "all": [
      {
        "any": [
          { "slot": "patient.is_pregnant", "is_true": true },
          { "slot": "hpi.is_pregnant", "is_true": true }
        ]
      },
      {
        "any": [
          { "slot": "symptoms.pregnancy_bleeding", "is_true": true },
          { "slot": "hpi.pregnancy_bleeding", "is_true": true },
          { "slot": "symptoms.severe_headache", "is_true": true },
          { "slot": "hpi.severe_headache", "is_true": true },
          { "slot": "symptoms.reduced_fetal_movement", "is_true": true },
          { "slot": "hpi.reduced_fetal_movement", "is_true": true },
          { "slot": "symptoms.convulsions", "is_true": true },
          { "slot": "hpi.convulsions", "is_true": true }
        ]
      }
    ]
  },
  "action": {
    "escalate": "triage_desk",
    "queue_priority": "immediate",
    "patient_message_key": "calm_wait"
  },
  "approved_by": "CAB-2026-03",
  "approved_at": "2026-03-14"
}
