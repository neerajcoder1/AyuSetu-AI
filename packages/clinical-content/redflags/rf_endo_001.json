{
  "id": "RF-ENDO-001",
  "tier": 1,
  "version": 2,
  "title": "Hyperglycemic Crisis / Metabolic Emergency",
  "description": "Known diabetes presenting with acute drowsiness, confusion, severe vomiting, or extreme blood glucose values",
  "when": {
    "all": [
      {
        "any": [
          { "slot": "past_history.diabetes", "is_true": true },
          { "slot": "hpi.diabetes", "is_true": true }
        ]
      },
      {
        "any": [
          { "slot": "symptoms.severe_vomiting", "is_true": true },
          { "slot": "hpi.severe_vomiting", "is_true": true },
          { "slot": "symptoms.altered_sensorium", "is_true": true },
          { "slot": "hpi.altered_sensorium", "is_true": true },
          { "slot": "symptoms.drowsiness", "is_true": true },
          { "slot": "hpi.drowsiness", "is_true": true },
          { "slot": "symptoms.confusion", "is_true": true },
          { "slot": "hpi.confusion", "is_true": true },
          { "slot": "vitals.glucose_extreme", "is_true": true }
        ]
      }
    ]
  },
  "action": {
    "escalate": "triage_desk",
    "queue_priority": "immediate",
    "patient_message_key": "calm_wait"
  },
  "approved_by": "CAB-2026-03",
  "approved_at": "2026-03-14"
}
