{
  "id": "RF-RESP-001",
  "tier": 1,
  "version": 2,
  "title": "Acute Respiratory Compromise",
  "description": "Breathlessness at rest, inability to complete a sentence, reported cyanosis, stridor, or documented hypoxia (SpO2 < 90%)",
  "when": {
    "any": [
      { "slot": "symptoms.breathlessness_at_rest", "is_true": true },
      { "slot": "hpi.breathlessness_at_rest", "is_true": true },
      { "slot": "symptoms.inability_to_complete_sentence", "is_true": true },
      { "slot": "hpi.inability_to_complete_sentence", "is_true": true },
      { "slot": "symptoms.cyanosis", "is_true": true },
      { "slot": "hpi.cyanosis", "is_true": true },
      { "slot": "symptoms.stridor", "is_true": true },
      { "slot": "hpi.stridor", "is_true": true },
      { "slot": "symptoms.dyspnea_severe", "is_true": true },
      { "slot": "hpi.dyspnea_severe", "is_true": true },
      { "slot": "vitals.spo2", "lt": 90.0 }
    ]
  },
  "action": {
    "escalate": "triage_desk",
    "queue_priority": "immediate",
    "patient_message_key": "calm_wait"
  },
  "approved_by": "CAB-2026-03",
  "approved_at": "2026-03-14"
}
