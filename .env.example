# AyuSetu AI — Configuration Template
# =========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git — it is listed in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   pip install -r requirements.txt
#   pytest

# ─── Core Environment ─────────────────────────────────────────────────────────
AYUSETU_ENV=dev
DEBUG=true

# ─── Database & Storage ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://ayusetu:ayusetu_dev_secret@localhost:5432/ayusetu_db
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_ENDPOINT=http://localhost:9000
KMS_ENDPOINT=

# ─── Clinical Behaviour (Tunable without a deploy per PRD §22.9) ──────────────
SESSION_TTL_MINUTES=30
QUESTION_BUDGET=40
INTERVIEW_BUDGET_SECONDS=480
ASR_CONFIDENCE_FLOOR=0.65
OCR_CONFIDENCE_AMBER=0.80
STUCK_DETECT_SECONDS=45
TIER1_ESCALATE_SECONDS=90
TIER1_ESCALATE2_SECONDS=180
COMPANION_LINK_TTL_MINUTES=60

# ─── Model selection ──────────────────────────────────────────────────────────
# Set ASR_MODEL to switch between models without changing code.

# Primary development candidate (Phase 1):
ASR_MODEL=shunyalabs/zero-stt-hinglish
ASR_FALLBACK=bhashini
LLM_MODEL=local
LLM_MAX_TOKENS=1024
MODEL_SIGNING_PUBKEY=

# Hindi specialist (for evaluation comparison):
# ASR_MODEL=ARTPARK-IISc/whisper-large-v3-vaani-hindi

# Neutral baseline (for evaluation comparison):
# ASR_MODEL=openai/whisper-large-v3-turbo

# ─── Backend ──────────────────────────────────────────────────────────────────
# transformers   : Use HuggingFace transformers (recommended for Phase 1)
# faster-whisper : Use CTranslate2 (requires model conversion, see README.md)

ASR_BACKEND=transformers

# ─── Inference hardware ───────────────────────────────────────────────────────
# Device: "cpu" or "cuda"
ASR_DEVICE=cpu

# Compute type: "int8" (CPU), "float16" (GPU), "float32" (any)
# int8 is recommended for CPU-only demo hardware.
ASR_COMPUTE_TYPE=int8

# ─── Language configuration ───────────────────────────────────────────────────
# CRITICAL NOTE:
#   For shunyalabs/zero-stt-hinglish, leave ASR_FORCE_LANGUAGE empty.
#   Setting it to "hi" or "en" will force monolingual decoding and WILL
#   suppress the mixed-script (Hinglish) output this model is designed for.
#
#   For ARTPARK-IISc/whisper-large-v3-vaani-hindi: set to "hi" (per model card).
#   For openai/whisper-large-v3-turbo baseline: leave empty.

ASR_FORCE_LANGUAGE=

# ─── Quality thresholds ───────────────────────────────────────────────────────
# Utterances with confidence below this value trigger a re-prompt warning.
# This does not automatically re-ask the patient — it is a signal to the
# conversation engine.
ASR_CONFIDENCE_THRESHOLD=0.60

# Maximum accepted audio duration in seconds. Files longer than this are rejected.
ASR_MAX_DURATION_SECONDS=120.0

# ─── HuggingFace authentication ───────────────────────────────────────────────
# Required if you need to access private or gated models.
# Get your token at: https://huggingface.co/settings/tokens
# Leave empty if the model is public (all three evaluation models are public).
HF_TOKEN=

# ─── Integrations (absence must degrade, never crash per PRD §22.9) ───────────
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_MODE=mock
HIS_ADAPTER=none

# ─── Security ─────────────────────────────────────────────────────────────────
MTLS_CA_BUNDLE=
REQUEST_SIGNING_PUBKEYS=
EGRESS_ALLOWLIST=

